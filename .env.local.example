# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Do NOT add SUPABASE_SERVICE_ROLE_KEY here or anywhere in this project.
# This app never needs it - admin access is enforced entirely through
# Row Level Security policies using the regular authenticated session.
